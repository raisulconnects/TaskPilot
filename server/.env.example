# Copy to `.env` and fill in. Never commit `.env`.
# Local dev uses Docker Postgres on host port 5433 (5432 is commonly taken);
# hosted/production uses Supabase (direct URL for migrations, pooled for runtime).

# Prisma / app database (REQUIRED).
DATABASE_URL="postgresql://taskpilot:taskpilot@localhost:5433/taskpilot?schema=public"
# Supabase examples (fill in after creating the project):
# DATABASE_URL="postgresql://postgres:PASSWORD@db.PROJECT.supabase.co:5432/postgres"  # direct: migrations + local dev
# Pooled (port 6543, transaction mode): runtime only, set as the deploy env var.

# Integration tests only: when set, tests/integration/rls.test.js runs
# against this DB; when unset it skips. Same value as DATABASE_URL locally.
# TEST_DATABASE_URL="postgresql://taskpilot:taskpilot@localhost:5433/taskpilot?schema=public"

# Auth signing secret (REQUIRED). Any long random string; CI uses a fake.
JWT_SECRET="change-me-to-a-long-random-string"

# Server port.
PORT=5000

# Comma-separated allowed frontend origins (Socket.IO + Express CORS).
# CORS_ORIGINS="http://localhost:5173"

# Google Gemini (AI task autofill). Absent key = AI routes 500, rest works.
GEMINI_API_KEY=""
