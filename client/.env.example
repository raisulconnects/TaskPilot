# Copy to `.env` and adjust per environment. Never commit `.env`.
# Client .env is LOCAL-ONLY (gitignored) — missing vars fail silently at
# runtime, which once killed realtime locally for months. Keep this file
# accurate.

# REST API base (must end with /api).
VITE_API_BASE_URL=http://localhost:5000/api
# Production example:
# VITE_API_BASE_URL=https://taskpilot-backend-q5rv.onrender.com/api

# Socket.IO server origin (NO trailing /api, NO trailing slash).
# If unset, the app derives it from VITE_API_BASE_URL (strips /api) and logs
# a console warning. Set it explicitly when sockets live elsewhere.
VITE_SOCKET_URL=http://localhost:5000
# Production example:
# VITE_SOCKET_URL=https://taskpilot-backend-q5rv.onrender.com
